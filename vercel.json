{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "regions": ["hkg1"],
  "crons": [
    {
      "path": "/api/cron/outbox-dispatch",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/stale-batches",
      "schedule": "30 2 * * *"
    }
  ]
}
