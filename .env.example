# DeepSeek 大模型配置
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# V3 集成 API 鉴权（与 V3 的 V2_API_KEY 保持一致）
INTEGRATION_API_KEY=waybill-v3-secret-key

# Postgres（Vercel Neon 会自动注入，本地请填写）
# POSTGRES_URL=
# DATABASE_URL=

# 异步导入 / Outbox / Worker
CRON_SECRET=local-dev-cron-secret
IMPORT_BATCH_SIZE=1000
IMPORT_WORKER_CONCURRENCY=3
SKU_VALIDATE_TIMEOUT_MS=3000
IMPORT_STALE_BATCH_MINUTES=5
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 可选：Upstash QStash（不配置则本地 Dispatcher 直调 Worker）
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=
